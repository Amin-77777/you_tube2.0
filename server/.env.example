# Server Port & MongoDB Atlas Connection
PORT=5000
DB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/yourtube?retryWrites=true&w=majority

# Security & JWT Tokens
JWT_SECRET=yourtube_jwt_super_secret_key_2026
OTP_SECRET=yourtube_otp_hash_salt_2026

# OTP Policy Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Trusted Devices Duration (Days)
TRUSTED_DEVICE_DURATION_DAYS=30

# Email Delivery Configuration (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM_ADDRESS=security@yourtube.app

# Optional IP Geolocation Provider
IP_GEOLOCATION_API_KEY=

# Optional SMS Gateway Provider
SMS_PROVIDER_API_KEY=

# Multilingual Commenting & Moderation System Configuration
COMMENT_EDIT_TIME_LIMIT_MINUTES=15
MAX_COMMENT_LENGTH=2000
COMMENT_RATE_LIMIT=5
COMMENT_RATE_WINDOW=60000
REPLY_RATE_LIMIT=3
REPLY_RATE_WINDOW=30000
DUPLICATE_TIME_WINDOW=300000

# Administrator & Moderation Access Key
ADMIN_SECRET_KEY=yourtube_admin_secret_key_2026

# Anti-Spam CAPTCHA Configuration
CAPTCHA_SECRET=yourtube_captcha_secret_2026

# External Translation Provider Keys (Optional: fallback to built-in open translation)
GOOGLE_TRANSLATE_API_KEY=
TRANSLATION_API_KEY=
LIBRETRANSLATE_URL=
